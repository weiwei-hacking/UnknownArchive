{
  "manifest_version": 3,
  "name": "YT Cookie Grabber",
  "version": "1.0",
  "description": "Export YouTube cookies in Netscape format for yt-dlp",
  "permissions": ["cookies", "downloads"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "Export YouTube Cookies"
  },
  "background": {
    "service_worker": "background.js"
  }
}